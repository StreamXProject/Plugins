<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <permission android:name="com.music.streamx.permission.WEB_PLAYBACK" android:protectionLevel="signature" />
    <application android:label="Spotify" android:icon="@drawable/ic_spotify" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:enableOnBackInvokedCallback="true" android:usesCleartextTraffic="false">
        <activity android:name=".SpotifyActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:excludeFromRecents="true">
            <intent-filter><action android:name="com.music.streamx.action.EXTENSION" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="streamx.extension.api" android:value="1" />
            <meta-data android:name="streamx.extension.playback" android:value="remote_web_player" />
            <meta-data android:name="streamx.extension.playback_service" android:value="com.music.streamx.extensions.spotify.SpotifyPlaybackService" />
            <meta-data android:name="streamx.extension.type" android:value="source" />
            <meta-data android:name="streamx.extension.authority" android:value="${applicationId}.source" />
        </activity>
        <service android:name=".SpotifyPlaybackService" android:exported="true" android:permission="com.music.streamx.permission.WEB_PLAYBACK" android:foregroundServiceType="mediaPlayback" />
        <provider android:name=".SpotifyProvider" android:authorities="${applicationId}.source" android:exported="true" />
    </application>
</manifest>
